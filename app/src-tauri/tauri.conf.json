{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noise Canceller",
  "version": "0.2.2",
  "identifier": "com.noisecanceller.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noise Canceller",
        "width": 1100,
        "height": 800,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Venokur",
    "copyright": "© 2026 Venokur",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/Venokur/noise-canceller",
    "shortDescription": "Подавляет шум и убирает чужие голоса из микрофона",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../models/voxlock/enroll.onnx": "models/voxlock/enroll.onnx",
      "../models/voxlock/chunk_int8.onnx": "models/voxlock/chunk_int8.onnx",
      "../models/voxlock/README.md": "models/voxlock/README.md",
      "../models/denoise/gtcrn.onnx": "models/denoise/gtcrn.onnx",
    "../models/denoise/dpdfnet4.onnx": "models/denoise/dpdfnet4.onnx",
      "../models/denoise/silero_vad.onnx": "models/denoise/silero_vad.onnx",
      "../models/bwe/novasr.onnx": "models/bwe/novasr.onnx",
      "../native/sherpa-onnx-c-api.dll": "native/sherpa-onnx-c-api.dll",
      "../native/onnxruntime.dll": "native/onnxruntime.dll",
      "../../licenses/README.md": "licenses/README.md",
      "../../licenses/apache-2.0.txt": "licenses/apache-2.0.txt",
      "../../licenses/gtcrn-LICENSE.txt": "licenses/gtcrn-LICENSE.txt",
      "../../licenses/lucide-LICENSE.txt": "licenses/lucide-LICENSE.txt",
      "../../licenses/mit.txt": "licenses/mit.txt",
      "../../licenses/onnxruntime-LICENSE.txt": "licenses/onnxruntime-LICENSE.txt",
      "../../licenses/silero-vad-LICENSE.txt": "licenses/silero-vad-LICENSE.txt",
      "../../licenses/voxlock-NOTICE.txt": "licenses/voxlock-NOTICE.txt",
      "../../licenses/novasr-LICENSE.txt": "licenses/novasr-LICENSE.txt",
      "../../licenses/novasr-NOTICE.txt": "licenses/novasr-NOTICE.txt",
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}